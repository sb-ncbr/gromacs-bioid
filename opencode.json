{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny"
  },
   "provider": {
      "litellm": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "LiteLLM",
        "options": {
          "baseURL": "https://llm.ai.e-infra.cz/v1"
        },
        "models": {
          "kimi-k3": {
            "name": "kimi-k3"
          },
          "gpt-oss-120b": {
            "name": "gpt-oss-120b"
          },
          "glm-5.1": {
            "name": "glm-5.1"
          },
          "qwen3.5": {
            "name": "qwen3.5",
            "limit": {
              "context": 280000,
              "output": 280000
            }
          },
          "deepseek-v4-pro-thinking": {
            "name": "deepseek-v4-pro-thinking"
          }
        }
      }
    }
}
