FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential libvips ncbi-blast+ && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONPATH=/app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

# Purge stale __pycache__ and .pyc/.pyo files to prevent AttributeError from stale bytecode
RUN find /app -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && find /app -type f -name "*.pyc" -delete && find /app -type f -name "*.pyo" -delete

RUN mkdir -p /app/runs /app/databases && chown -R 1000:1000 /app

USER 1000

# FALLBACK CMD ONLY - every production worker deployment overrides this
# (verified 2026-10-04, audit F-02):
#   validation-worker:        -A tasks             --concurrency=2 --prefetch-multiplier=1
#   bat3-ceitec-bat3-worker:  -A src_new.celery_app --concurrency=2 --prefetch-multiplier=1
#   bat3-ui-worker:           -A src_new.celery_app --concurrency=2 -Q validation.ui.celery
# Do not rely on this CMD for production semantics; it exists for local runs.
CMD ["celery", "-A", "src_new.celery_app", "worker", "--loglevel=info", "--pool=threads", "--concurrency=2", "--prefetch-multiplier=1"]
