FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential libvips ncbi-blast+ && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONPATH=/app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

# Purge stale __pycache__ and .pyc/.pyo files to prevent AttributeError from stale bytecode
RUN find /app -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && find /app -type f -name "*.pyc" -delete && find /app -type f -name "*.pyo" -delete

RUN mv /app/main.py /app/main.py.old 2>/dev/null || true
RUN mkdir -p /app/runs /app/databases && chown -R 1000:1000 /app

USER 1000

EXPOSE 8000

CMD ["uvicorn", "src_new.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
