# Validation API image, REPO-ROOT context (build: docker build -f Dockerfile.full -t cerit.io/tomsko/bat3-validation-api:<tag> .)
# Serves BOTH entrypoints:
#   python -m uvicorn main:app          (validation API + scheduler; /app modules)
#   uvicorn src_new.api.main:app        (bat3 pipeline api; cwd /app — see V-28:
#                                        ceitec api deployments must pin this entrypoint
#                                        as command/args; image CMD is main:app)
#   celery -A tasks worker              (validation worker; /app/tasks.py)
# Canonical home: this repo (bat3). The historical copy in ../bat3_validation/api/
# is legacy and was the source of the v3.133 content regression (V-28/V-29).
FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential libvips ncbi-blast+ media-types \
        libgl1 libegl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONPATH=/app
# Network-flake hardening for the pip layer (slow-link read timeouts observed 2026-10-11)
ENV PIP_DEFAULT_TIMEOUT=600 PIP_RETRIES=20

COPY requirements.txt /tmp/req-root.txt
RUN pip install --no-cache-dir -r /tmp/req-root.txt apscheduler==3.10.4

# render_png task (v3.137): headless static previews for the UI fallback.
# pymol-open-source 3.1.0a0 ships a cp311 manylinux_2_34 wheel (glibc 2.36 ok);
# batch mode `pymol -cq -` with ray=1 needs NO X/GL (software raytrace).
# Content gate at build time MUST verify: `which pymol` + real mini-cif render
# (V-29 lesson: image content regressions only surface with explicit probes;
# see build command notes in docs).
RUN pip install --no-cache-dir pymol-open-source==3.1.0a0

# foldseek static binary (v3.138): 3Di structure search. Release ships
# per-ISA builds; install avx2 + sse2 under /opt/foldseek and a CPU-feature
# wrapper as /usr/local/bin/foldseek (see scripts/docker/foldseek-wrapper.sh).
# `foldseek version` at the end doubles as a build gate (fails the build if
# the binary cannot run on this toolchain).
ARG FOLDSEEK_VERSION=9-427df8a
COPY scripts/docker/download_with_retry.py /tmp/download_with_retry.py
RUN set -eux; \
    base="https://github.com/steineggerlab/foldseek/releases/download/${FOLDSEEK_VERSION}"; \
    mkdir -p /opt/foldseek /tmp/foldseek-dl; \
    for isa in avx2 sse2; do \
      python /tmp/download_with_retry.py "${base}/foldseek-linux-${isa}.tar.gz" "/tmp/foldseek-dl/${isa}.tar.gz"; \
      tar xzf "/tmp/foldseek-dl/${isa}.tar.gz" -C /opt/foldseek; \
      mv /opt/foldseek/foldseek/bin/foldseek "/opt/foldseek/foldseek-${isa}"; \
      rm -rf /opt/foldseek/foldseek "/tmp/foldseek-dl/${isa}.tar.gz"; \
    done; \
    rmdir /tmp/foldseek-dl
COPY scripts/docker/foldseek-wrapper.sh /usr/local/bin/foldseek
RUN chmod +x /usr/local/bin/foldseek && foldseek version

COPY . /app
RUN find /app -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && \
    find /app -type f -name "*.pyc" -delete

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
