# Build stage
FROM node:22 AS builder
WORKDIR /usr/src/app
COPY ui/package*.json ./
RUN npm ci
COPY ui .
RUN npm run build

# Runtime stage
FROM nginxinc/nginx-unprivileged:1.27
COPY --from=builder /usr/src/app/dist /var/www/app
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 8081
